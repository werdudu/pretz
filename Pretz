    <!-- Toast -->
    <div id="toast" class="fixed top-6 left-1/2 -translate-x-1/2 z-[60] bg-slate-800/90 backdrop-blur-md text-white px-5 py-3 rounded-full shadow-2xl flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-300"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span id="toast-message" class="text-sm font-medium">Mensagem</span>
    </div>

    <script>
        const apiKey = ""; 

        const state = {
            cardCount: parseInt(localStorage.getItem('pretz_card_count')) || 5,
            session: {
                cards: [],
                currentCardIndex: 0,
                hits: 0,
                misses: 0,
                answers: []
            }
        };

        const dom = {
            views: {
                home: document.getElementById('view-home'),
                loading: document.getElementById('view-loading'),
                card: document.getElementById('view-card'),
                report: document.getElementById('view-report')
            },
            home: {
                inputCards: document.getElementById('input-cards'),
                btnStart: document.getElementById('btn-start')
            },
            card: {
                progress: document.getElementById('card-progress'),
                btnQuit: document.getElementById('btn-quit'),
                question: document.getElementById('card-question'),
                options: document.getElementById('card-options'),
                feedback: document.getElementById('card-feedback'),
                feedbackIcon: document.getElementById('feedback-icon'),
                feedbackTitle: document.getElementById('feedback-result-title'),
                feedbackAnswer: document.getElementById('feedback-correct-answer'),
                btnEvals: document.querySelectorAll('.btn-eval')
            },
            report: {
                hits: document.getElementById('report-hits'),
                misses: document.getElementById('report-misses'),
                history: document.getElementById('report-history'),
                aiAnalysis: document.getElementById('report-ai-analysis'),
                btnHome: document.getElementById('btn-home'),
                btnDownload: document.getElementById('btn-download-pdf'),
                exportContent: document.getElementById('report-export-content')
            },
            settings: {
                modal: document.getElementById('modal-settings'),
                content: document.getElementById('modal-settings-content'),
                btnOpen: document.getElementById('btn-settings'),
                btnClose: document.getElementById('btn-settings-close'),
                btnSave: document.getElementById('btn-settings-save'),
                inputCount: document.getElementById('input-card-count')
            },
            toast: {
                el: document.getElementById('toast'),
                msg: document.getElementById('toast-message')
            }
        };

        function showView(viewName) {
            Object.values(dom.views).forEach(v => {
                v.classList.add('hidden');
                v.classList.remove('flex');
            });
            dom.views[viewName].classList.remove('hidden');
            dom.views[viewName].classList.add('flex');
        }

        function showToast(message) {
            dom.toast.msg.textContent = message;
            dom.toast.el.classList.remove('opacity-0', 'pointer-events-none');
            dom.toast.el.classList.add('opacity-100');
            setTimeout(() => {
                dom.toast.el.classList.remove('opacity-100');
                dom.toast.el.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }

        dom.settings.btnOpen.addEventListener('click', () => {
            dom.settings.inputCount.value = state.cardCount;
            dom.settings.modal.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => dom.settings.content.classList.remove('scale-95'), 10);
        });

        function closeSettings() {
            dom.settings.content.classList.add('scale-95');
            setTimeout(() => dom.settings.modal.classList.add('opacity-0', 'pointer-events-none'), 200);
        }

        dom.settings.btnClose.addEventListener('click', closeSettings);

        dom.settings.btnSave.addEventListener('click', () => {
            const count = parseInt(dom.settings.inputCount.value);
            if (count > 0 && count <= 100) {
                state.cardCount = count;
                localStorage.setItem('pretz_card_count', count);
            }
            showToast('Configurações salvas!');
            closeSettings();
        });

        async function fetchWithRetry(url, options, retries = 5) {
            const delays = [1000, 2000, 4000, 8000, 16000];
            for (let i = 0; i < retries; i++) {
                try {
                    const res = await fetch(url, options);
                    if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
                    return await res.json();
                } catch (error) {
                    if (i === retries - 1) throw error;
                    await new Promise(r => setTimeout(r, delays[i]));
                }
            }
        }

        dom.home.btnStart.addEventListener('click', async () => {
            const text = dom.home.inputCards.value.trim();
            if (!text) {
                showToast('Cole o texto com o conteúdo para os flashcards.');
                return;
            }

            state.session.cards = [];
            state.session.currentCardIndex = 0;
            state.session.hits = 0;
            state.session.misses = 0;
            state.session.answers = [];

            showView('loading');
            document.getElementById('loading-title').textContent = "Estruturando Cards...";
            document.getElementById('loading-subtitle').textContent = "Transformando seu texto...";

            try {
                const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
                
                const systemPrompt = `Você é um estruturador de flashcards. Sua missão é extrair ou criar até ${state.cardCount} perguntas diretas a partir do conteúdo. Para cada pergunta, gere 4 alternativas padronizadas (mesmo tamanho aproximado) e defina a correta. Retorne APENAS um JSON no formato de array.`;
                
                const responseJson = await fetchWithRetry(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: `Texto original:\n${text}` }] }],
                        systemInstruction: { parts: [{ text: systemPrompt }] },
                        generationConfig: { 
                            responseMimeType: "application/json",
                            responseSchema: {
                                type: "ARRAY",
                                items: {
                                    type: "OBJECT",
                                    properties: {
                                        question: { type: "STRING" },
                                        options: { type: "ARRAY", items: { type: "STRING" } },
                                        correctOptionIndex: { type: "INTEGER" }
                                    }
                                }
                            }
                        }
                    })
                });

                const contentText = responseJson.candidates?.[0]?.content?.parts?.[0]?.text;
                if (!contentText) throw new Error("Erro de comunicação com a IA");

                const cards = JSON.parse(contentText);
                if (!cards || cards.length === 0) throw new Error("A IA não retornou nenhum card válido");

                state.session.cards = cards;
                renderCard();
                showView('card');

            } catch (err) {
                showToast('Erro: ' + err.message);
                showView('home');
            }
        });

        function renderCard() {
            const card = state.session.cards[state.session.currentCardIndex];
            dom.card.progress.textContent = `${state.session.currentCardIndex + 1} / ${state.session.cards.length}`;
            dom.card.question.textContent = card.question;
           
            dom.card.options.innerHTML = '';
            dom.card.feedback.classList.add('hidden');
            dom.card.feedback.classList.remove('flex', 'opacity-100');
           
            card.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = opt;
                btn.onclick = () => handleAnswer(idx);
                dom.card.options.appendChild(btn);
            });
        }

        function handleAnswer(selectedIndex) {
            const card = state.session.cards[state.session.currentCardIndex];
            const isCorrect = selectedIndex === card.correctOptionIndex;
           
            const buttons = dom.card.options.querySelectorAll('.option-btn');
            buttons.forEach(b => b.disabled = true);
           
            buttons[selectedIndex].classList.add(isCorrect ? 'selected-correct' : 'selected-wrong');
            buttons[card.correctOptionIndex].classList.add('correct');
           
            if (isCorrect) state.session.hits++;
            else state.session.misses++;
           
            dom.card.feedbackIcon.textContent = isCorrect ? '✅' : '❌';
            dom.card.feedbackIcon.className = `w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center text-3xl ${isCorrect ? 'bg-green-100' : 'bg-red-100'}`;
            dom.card.feedbackTitle.textContent = isCorrect ? 'Correto!' : 'Incorreto!';
            dom.card.feedbackTitle.className = `text-3xl font-black mb-2 ${isCorrect ? 'text-green-500' : 'text-red-500'}`;
            dom.card.feedbackAnswer.textContent = card.options[card.correctOptionIndex];
           
            state.session.answers.push({
                question: card.question,
                options: card.options,
                correctAnswer: card.options[card.correctOptionIndex],
                userAnswer: card.options[selectedIndex],
                isCorrect: isCorrect,
                evalLevel: null
            });
           
            dom.card.feedback.classList.remove('hidden');
            dom.card.feedback.classList.add('flex');
            setTimeout(() => dom.card.feedback.classList.add('opacity-100'), 50);
        }

        dom.card.btnEvals.forEach(btn => {
            btn.addEventListener('click', () => {
                state.session.answers[state.session.currentCardIndex].evalLevel = btn.textContent;
                state.session.currentCardIndex++;
                if (state.session.currentCardIndex < state.session.cards.length) {
                    renderCard();
                } else {
                    generateReport();
                }
            });
        });

        dom.card.btnQuit.addEventListener('click', () => {
            const modal = document.createElement('div');
            modal.className = "fixed inset-0 bg-slate-900/60 z-[70] flex items-center justify-center p-6";
            modal.innerHTML = `
                <div class="bg-white rounded-3xl p-6 shadow-2xl max-w-sm w-full text-center">
                    <h3 class="text-xl font-bold text-slate-800 mb-2">Sair da Sessão?</h3>
                    <p class="text-slate-600 text-sm mb-6">Seu progresso atual será perdido.</p>
                    <div class="flex gap-3 justify-center">
                        <button class="px-5 py-2.5 bg-slate-100 rounded-xl text-slate-700 font-bold" onclick="this.parentElement.parentElement.parentElement.remove()">Cancelar</button>
                        <button class="px-5 py-2.5 bg-red-500 rounded-xl text-white font-bold" onclick="showView('home'); this.parentElement.parentElement.parentElement.remove()">Sair</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
        });

        async function generateReport() {
            showView('report');
            dom.report.hits.textContent = state.session.hits;
            dom.report.misses.textContent = state.session.misses;

            dom.report.history.innerHTML = state.session.answers.map((ans, idx) => `
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm text-left">
                    <p class="font-bold text-slate-800 text-sm mb-3"><span class="text-purple-500 mr-1">#${idx + 1}</span> ${ans.question}</p>
                    <div class="space-y-2 mb-3">
                        ${ans.options.map(opt => {
                            let style = "text-slate-600 bg-slate-50 border-slate-100";
                            if (opt === ans.correctAnswer) style = "text-green-800 bg-green-100 font-bold border-green-300 ring-2 ring-green-400";
                            else if (opt === ans.userAnswer && !ans.isCorrect) style = "text-red-800 bg-red-100 font-bold border-red-300 ring-2 ring-red-400";
                            return `<div class="text-xs p-2.5 rounded-xl border ${style}">${opt}</div>`;
                        }).join('')}
                    </div>
                    <div class="flex justify-between items-center text-xs mt-2 pt-3 border-t border-slate-100">
                        <span class="font-bold ${ans.isCorrect ? 'text-green-600' : 'text-red-600'} flex items-center gap-1">
                            ${ans.isCorrect ? '✅ Acertou' : '❌ Errou'}
                        </span>
                        <span class="text-slate-500 font-bold bg-slate-100 px-2 py-1 rounded-lg">Dificuldade: ${ans.evalLevel}</span>
                    </div>
                </div>`).join('');
           
            if (state.session.misses === 0) {
                dom.report.aiAnalysis.innerHTML = '<p class="text-green-600 font-bold text-center">Excelente! Você acertou tudo.</p>';
                return;
            }

            dom.report.aiAnalysis.innerHTML = `<div class="animate-pulse flex space-x-4"><div class="flex-1 space-y-4 py-1"><div class="h-2 bg-slate-300 rounded"></div><div class="space-y-2"><div class="h-2 bg-slate-300 rounded"></div><div class="h-2 bg-slate-300 rounded w-5/6"></div></div></div></div>`;

            try {
                const wrongAnswers = state.session.answers.filter(a => !a.isCorrect);
                const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
                
                const res = await fetchWithRetry(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: `O aluno acertou ${state.session.hits} e errou ${state.session.misses}. Erros: ${JSON.stringify(wrongAnswers)}. Faça uma breve hipótese do motivo do erro e dê uma dica pontual. Responda em HTML simples (p, strong, ul, li) sem blocos markdown.` }] }]
                    })
                });

                let htmlContent = res.candidates?.[0]?.content?.parts?.[0]?.text || "Análise indisponível.";
                htmlContent = htmlContent.replace(/```html/g, '').replace(/```/g, '');
                dom.report.aiAnalysis.innerHTML = htmlContent;

            } catch (e) {
                dom.report.aiAnalysis.innerHTML = '<p class="text-red-500 font-medium">Não foi possível carregar a análise da IA.</p>';
            }
        }

        dom.report.btnDownload.addEventListener('click', () => {
            showToast('Gerando PDF... Aguarde.');
            const element = dom.report.exportContent;
            html2pdf().set({
                margin: 0.5,
                filename: 'Pretz_Relatorio.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            }).from(element).save();
        });

        dom.report.btnHome.addEventListener('click', () => showView('home'));

    </script>
</body>
</html>
